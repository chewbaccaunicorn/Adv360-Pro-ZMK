#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
    };

    macros {
        Tilde: Tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp SPACE>;
            label = "TILDE";
        };

        enterLayerSwitch: enterLayerSwitch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER &tog 6>;
            label = "ENTERLAYERSWITCH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none         &kp N1  &kp N2    &kp N3    &kp N4     &kp N5  &none                                                                           &mo 3        &kp N6  &kp N7  &kp N8     &kp N9   &kp N0     &none
&kp TAB       &kp Q   &kp W     &kp E     &kp R      &kp T   &none                                                                           &none        &kp Y   &kp U   &kp I      &kp O    &kp P      &none
&lt 4 ESCAPE  &kp A   &kp S     &kp D     &kp F      &kp G   &to 5      &kp LCTRL        &kp LALT                    &kp LGUI   &kp RCTRL    &to 5        &kp H   &kp J   &kp K      &kp L    &kp LA(A)  &kp LA(SQT)
&kp LSHFT     &kp Z   &kp X     &kp C     &kp V      &kp B                               &mt LEFT_GUI LG(SPACE)      &kp PG_UP                            &kp N   &kp M   &kp COMMA  &kp DOT  &kp LA(O)  &kp RSHFT
&none         &none   &kp CAPS  &kp LEFT  &kp RIGHT          &lt 2 DEL  &lt 1 BACKSPACE  &kp LA(LC(LEFT_SHIFT))      &kp PG_DN  &lt 1 SPACE  &lt 2 ENTER          &kp UP  &kp DOWN   &none    &none      &none
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
&none  &kp EXCL          &kp AT             &kp HASH              &kp DOLLAR             &kp PERCENT    &none                                                   &none      &kp AMPS   &none             &none              &none      &none  &none
&none  &kp EQUAL         &kp PLUS           &kp MINUS             &kp ASTRK              &kp SLASH      &none                                                   &none      &kp CARET  &kp QUESTION      &kp UNDER          &kp PIPE   &none  &none
&none  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &none    &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GRAVE  &none  &none
&none  &kp COLON         &kp SEMICOLON      &kp LESS_THAN         &kp GREATER_THAN       &Tilde                             &kp HOME      &kp PG_UP                        &none      &kp LEFT_BRACE    &kp RIGHT_BRACE    &none      &none  &none
&none  &none             &none              &none                 &none                                 &kp DEL  &kp BSPC   &kp END       &kp PG_DN  &kp ENTER  &kp SPACE             &none             &none              &none      &none  &none
            >;
        };

        num {
            display-name = "num";
            bindings = <
&none  &none                 &none                 &none                 &none                 &none             &bootloader                                  &bootloader  &none   &none   &none   &none    &none    &none
&none  &kp F1                &kp F2                &kp F3                &kp F4                &kp F5            &none                                        &none        &kp F6  &kp F7  &kp F9  &kp F10  &kp F11  &kp F12
&none  &kp NUMBER_1          &kp N2                &kp N3                &kp N4                &kp N5            &none        &none  &none      &none  &none  &none        &kp N6  &kp N7  &kp N8  &kp N9   &kp N0   &none
&none  &kp C_VOL_DN          &kp C_VOL_UP          &kp C_PREV            &kp C_NEXT            &kp C_PLAY_PAUSE                      &none      &none                      &none   &none   &none   &none    &none    &none
&none  &kp LS(LG(NUMBER_4))  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_1))                    &none        &none  &none      &none  &none  &none                &none   &none   &none    &none    &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &none  &none  &none  &none  &none  &none                                                  &none            &none  &none       &none       &none  &none  &none
&none           &none  &none  &none  &none  &none  &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none  &none  &none  &none  &none  &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none  &none  &none  &none  &none                      &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none  &none  &none  &none         &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        windowManagement {
            bindings = <
&trans  &trans  &trans                   &trans                   &trans                   &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LA(LC(KP_NUMBER_7))  &kp LA(LC(KP_NUMBER_8))  &kp LA(LC(KP_NUMBER_9))  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LA(LC(KP_NUMBER_4))  &kp LA(LC(KP_NUMBER_5))  &kp LA(LC(KP_NUMBER_6))  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LA(LC(KP_NUMBER_1))  &kp LA(LC(KP_NUMBER_2))  &kp LA(LC(KP_NUMBER_3))  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                   &trans                   &trans                           &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        numpad {
            bindings = <
&trans  &trans  &kp EQUAL        &kp ASTERISK     &kp SLASH        &kp KP_NUMLOCK  &trans                                                 &trans     &kp KP_NUMLOCK  &kp EQUAL        &kp ASTERISK     &kp SLASH        &trans  &trans
&trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS        &trans                                                 &trans     &kp PLUS        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &trans
&trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS       &to 0    &trans         &trans      &trans  &trans     &to 0      &kp MINUS       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans  &trans
&trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER                            &trans      &trans                        &kp KP_ENTER    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans  &trans
&trans  &trans  &kp KP_NUMBER_0  &trans           &kp PERIOD                       &kp DEL  &kp BACKSPACE  &trans      &trans  &kp SPACE  &kp ENTER                  &kp KP_NUMBER_0  &trans           &kp PERIOD       &trans  &trans
            >;
        };

        gaming {
            bindings = <
&none  &none           &none  &none  &none  &none  &none                                      &none  &none  &none  &none  &none  &none  &none
&none  &none           &kp Q  &kp W  &kp E  &kp R  &none                                      &none  &none  &none  &none  &none  &none  &none
&none  &kp LEFT_SHIFT  &kp A  &kp S  &kp D  &kp F  &none  &none      &none      &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none           &kp Z  &kp X  &kp C  &none                    &none      &none                &none  &none  &none  &none  &none  &none
&none  &none           &none  &none  &none         &none  &kp SPACE  &none      &none  &none  &sl 7         &none  &none  &none  &none  &none
            >;
        };

        gaming_default {
            display-name = "Base";
            bindings = <
&none         &kp N1  &kp N2    &kp N3    &kp N4     &kp N5  &none                                                                           &mo 3              &kp N6  &kp N7  &kp N8     &kp N9   &kp N0     &none
&kp TAB       &kp Q   &kp W     &kp E     &kp R      &kp T   &none                                                                           &none              &kp Y   &kp U   &kp I      &kp O    &kp P      &none
&lt 4 ESCAPE  &kp A   &kp S     &kp D     &kp F      &kp G   &to 5      &kp LCTRL        &kp LALT                    &kp LGUI   &kp RCTRL    &to 5              &kp H   &kp J   &kp K      &kp L    &kp LA(A)  &kp LA(SQT)
&kp LSHFT     &kp Z   &kp X     &kp C     &kp V      &kp B                               &mt LEFT_GUI LG(SPACE)      &kp PG_UP                                  &kp N   &kp M   &kp COMMA  &kp DOT  &kp LA(O)  &kp RSHFT
&none         &none   &kp CAPS  &kp LEFT  &kp RIGHT          &lt 2 DEL  &lt 1 BACKSPACE  &kp LA(LC(LEFT_SHIFT))      &kp PG_DN  &lt 1 SPACE  &enterLayerSwitch          &kp UP  &kp DOWN   &none    &none      &none
            >;
        };
    };
};
